<?xml version="1.0" encoding="UTF-8"?>
<!--
  MusicWorld · IIS 配置
  把本文件放在站点根目录（与 index.html 同级）即可，作用：

  1. directoryBrowse：允许浏览器读取 music / lyrics 的目录列表，
     网页打开后即可自动扫描全部歌曲与歌词，无需手动导入。
     ※ 若打开站点报 500.19 且指向本节，说明服务器未安装「目录浏览」
       角色功能：在「服务器管理器 → 添加角色服务」里勾选
       「Web 服务器 → 常见 HTTP 功能 → 目录浏览」后重启 IIS；
       或者直接删除 <directoryBrowse ... /> 这一行，
       改用 python tools/scan.py 生成 manifest.json 的方式。

  2. staticContent：补充 IIS 默认缺少的音频 MIME 类型，
     否则 flac / ogg 等格式会返回 404.3 无法播放。
     若某一行与服务器已有配置冲突（同样报 500.19），删除该行即可。

  3. location(music/lyrics)：给音频与歌词文件设置显式 Cache-Control。
     IIS 默认不发 Cache-Control，浏览器走启发式缓存；Chromium 的媒体
     缓存在处理「可缓存的 Range 分段响应」时有缺陷，切歌时上一个
     请求被中断再写缓存会报 net::ERR_CACHE_OPERATION_NOT_SUPPORTED，
     导致下一首加载失败。显式 max-age 后浏览器按标准路径缓存，
     不再触发该缺陷。仅作用于 music/ 与 lyrics/，html/js/css 不受
     影响（改版即生效）。
-->
<configuration>
  <system.webServer>

    <directoryBrowse enabled="true" showFlags="Date, Time, Size, Extension" />

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <staticContent>
      <mimeMap fileExtension=".flac" mimeType="audio/flac" />
    </staticContent>

  </system.webServer>

  <location path="music">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="lyrics">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>
